# HTTPS and HTTP/2 in front of the site, with a certificate from Caddy's own
# local authority. Browsers will warn about it: it is for trying the site over
# TLS on a laptop, not a substitute for a real certificate.
{
	auto_https disable_redirects
}

# Certificates are issued for these names only. "tls" is this service's name
# inside the compose network, where the tests reach it.
localhost:8443, 127.0.0.1:8443, tls:8443 {
	tls internal
	reverse_proxy web:80 {
		# Pass stream events through as they come.
		flush_interval -1
		# The caller's address, as this proxy saw it. Whatever the caller put
		# in X-Forwarded-For itself is dropped.
		header_up X-Forwarded-For {remote_host}
	}
}
